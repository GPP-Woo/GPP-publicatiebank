#: woo_publications/publications/api/serializers/document.py:39
msgid "The unique ID for a given file part for a document."
msgstr "Het unieke ID van een bestandsdeel horend bij een document."

#: woo_publications/publications/api/serializers/document.py:43
msgid "url"
msgstr "url"

#: woo_publications/publications/api/serializers/document.py:44
msgid "Endpoint where to submit the file part data to."
msgstr "Endpoint waar het bestandsdeel geüpload moet worden."

#: woo_publications/publications/api/serializers/document.py:49
msgid "order"
msgstr "volgorde"

#: woo_publications/publications/api/serializers/document.py:50
msgid "Index of the filepart, indicating which chunk is being uploaded."
msgstr ""
"Index van het bestandsdeel, geeft aan welk bestandsdeel precies geüpload "
"wordt."

#: woo_publications/publications/api/serializers/document.py:55
msgid "size"
msgstr "grootte"

#: woo_publications/publications/api/serializers/document.py:57
msgid ""
"Chunk size, in bytes. Large files must be cut up into chunks, where each "
"chunk has an expected chunk size (configured on the Documents API server). A"
" part is only considered complete once each chunk has binary data of exactly"
" this size attached to it."
msgstr ""
"Bestandsdeelomvang, in bytes. Grote bestanden moeten in meerdere stukken "
"gesplitst worden, waarbij voor elk stuk een bepaalde bestandsgrootte "
"verwacht wordt (deze grootte is ingesteld op de Documenten-API-server). Een "
"bestandsdeel is pas voltooid als er binaire data van precies deze omvang "
"geüpload zijn."

#: woo_publications/publications/api/serializers/document.py:65
msgid "binary content"
msgstr "binaire data"

#: woo_publications/publications/api/serializers/document.py:67
msgid ""
"The binary data of this chunk, which will be forwarded to the underlying "
"Documents API. The file size must match the part's `omvang`."
msgstr ""
"De binaire data van dit stuk, dit wordt doorgezet naar de achterliggende "
"Documenten-API. De bestandsgrootte moet overeenkomen met de `omvang` van het"
" bestandsdeel."

#: woo_publications/publications/api/serializers/document.py:77
#: woo_publications/publications/api/serializers/document.py:117
msgid "document upload completed"
msgstr "documentupload voltooid"

#: woo_publications/publications/api/serializers/document.py:79
msgid ""
"Indicates if all chunks of the file have been received and the document has "
"been unlocked and made 'ready for use' in the upstream Documents API."
msgstr ""
"Geeft aan of alle bestandsdelen van het bestand ontvangen zijn en het "
"document ontgrendeld en klaar voor gebruik is in de achterliggende "
"Documenten-API."

#: woo_publications/publications/api/serializers/document.py:99
#: woo_publications/publications/api/serializers/document.py:295
#: woo_publications/publications/api/serializers/inzage_procedure.py:15
msgid "The unique identifier of the publication."
msgstr "De unieke identificatie van de publicatie."

#: woo_publications/publications/api/serializers/document.py:103
#: woo_publications/publications/api/serializers/publication.py:138
#: woo_publications/publications/models.py:240
msgid "owner"
msgstr "eigenaar"

#: woo_publications/publications/api/serializers/document.py:104
msgid "The creator of the document, derived from the audit headers."
msgstr "De aanmaker van het document, afgeleid uit de audit-headers."

#: woo_publications/publications/api/serializers/document.py:109
msgid "The document identifiers attached to this document."
msgstr "De set aan identificatiekenmerken horend bij dit document."

#: woo_publications/publications/api/serializers/document.py:119
msgid ""
"Indicates if the file has been uploaded and made 'ready for use' in the "
"upstream Documents API."
msgstr ""
"Geeft aan of alle bestandsdelen van het bestand ontvangen zijn en het "
"document ontgrendeld en klaar voor gebruik is in de achterliggende "
"Documenten-API."

#: woo_publications/publications/api/serializers/document.py:157
msgid ""
"\n"
"On creation, the publicatiestatus is derived from the publication and cannot be specified directly."
msgstr ""
"\n"
"Tijdens het aanmaken wordt de publicatiestatus overgenomen van het publicatie. De publicatie kan niet zelf ingevuld worden."

#: woo_publications/publications/api/serializers/document.py:190
msgid "Adding documents to revoked publications is not allowed."
msgstr "Je kan geen documenten toevoegen aan ingetrokken publicaties."

#: woo_publications/publications/api/serializers/document.py:205
msgid "document URL"
msgstr "document-URL"

#: woo_publications/publications/api/serializers/document.py:209
msgid ""
"The resource URL of the document in an (external) Documents API. Must be the"
" detail endpoint - we'll construct the download URL ourselves. Must be "
"provided when the `aanleveringBestand` is set to `ophalen`, and must be "
"empty/absent when `aanleveringBestand` is `ontvangen`. Note that you may "
"include the `versie` query parameter to point to a particular document "
"version."
msgstr ""
"De bronlocatie (URL) van het document in een (externe) Documenten API. Dit "
"moet verwijzen naar de detail-endpoint - wij bouwen vervolgens de download-"
"URL  op. Dit veld moet opgegeven worden wanneer het "
"`aanleveringBestand`-veld op `ophalen` staat, dit veld moet dan ook leeg "
"zijn als het `aanleveringBestand` veld op `ontvangen` staat. Merk op dat je "
"de `versie` query-parameter kan opnemen om naar een specifieke "
"documentversie te verwijzen. "

#: woo_publications/publications/api/serializers/document.py:230
msgid "delivery method"
msgstr "aanleverwijze"

#: woo_publications/publications/api/serializers/document.py:234
msgid ""
"When the delivery method is set to retrieve a provided document URL pointing"
" to a Documents API, then this will be processed in the background and no "
"`bestandsdelen` will be returned. Otherwise for direct uploads, an array of "
"expected file parts is returned."
msgstr ""
"Als de aanleverwijze op `ophalen` staat, dan wordt dit verwerkt op de "
"achtergrond en worden er geen `bestandsdelen` teruggegeven in het antwoord. "
"Voor directe uploads wordt er een lijst van verwachte `bestandsdelen` "
"teruggegeven."

#: woo_publications/publications/api/serializers/document.py:241
msgid "file parts"
msgstr "bestandsdelen"

#: woo_publications/publications/api/serializers/document.py:243
msgid ""
"The expected file parts/chunks to upload the file contents. These are "
"derived from the specified total file size (`bestandsomvang`) in the "
"document create body."
msgstr ""
"De verwachte bestandsdelen/chunks om de bestandsinhoud te uploaden. Deze "
"zijn afgeleid uit de opgegeven totale bestandsgrootte (`bestandsomvang`) in "
"de body van de document-create-operatie."

#: woo_publications/publications/api/serializers/inzage_procedure.py:18
#: woo_publications/publications/models.py:319
msgid "in effect until"
msgstr "datum einde geldigheid"

